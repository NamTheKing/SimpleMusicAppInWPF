<Window x:Class="SimpleMusicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Music Player" Height="520" Width="420" MinHeight="420" MinWidth="360"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header + Add button -->
            <RowDefinition Height="*"/>    <!-- Playlist -->
            <RowDefinition Height="Auto"/> <!-- Now playing -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
            <RowDefinition Height="Auto"/> <!-- Volume -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="＋ Add songs" Padding="10,4"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="AddSongs_Click"/>
            <TextBlock Text="🎵 Playlist" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Playlist -->
        <ListBox x:Name="PlaylistBox" Grid.Row="1"
                 DisplayMemberPath="Title"
                 Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                 BorderThickness="0" Padding="4" FontSize="14"
                 MouseDoubleClick="PlaylistBox_MouseDoubleClick"
                 KeyDown="PlaylistBox_KeyDown"/>

        <!-- Now playing -->
        <TextBlock x:Name="NowPlayingText" Grid.Row="2" Margin="0,14,0,4"
                   Text="Nothing playing — add or drop some songs"
                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextBrush}"/>

        <!-- Progress -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="{StaticResource SubTextBrush}"
                       VerticalAlignment="Center"/>
            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                    Thumb.DragStarted="ProgressSlider_DragStarted"
                    Thumb.DragCompleted="ProgressSlider_DragCompleted"
                    ValueChanged="ProgressSlider_ValueChanged"/>
            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00"
                       Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Control buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
            <Button Style="{StaticResource ControlButton}" Content="⏮" ToolTip="Previous" Click="Previous_Click"/>
            <Button Style="{StaticResource ControlButton}" Content="⏹" ToolTip="Stop" Click="Stop_Click"/>
            <Button x:Name="PlayPauseButton" Style="{StaticResource ControlButton}"
                    Width="56" Height="56" FontSize="20"
                    Background="{StaticResource AccentBrush}"
                    Content="▶" ToolTip="Play / Pause" Click="PlayPause_Click"/>
            <Button Style="{StaticResource ControlButton}" Content="⏭" ToolTip="Next" Click="Next_Click"/>
        </StackPanel>

        <!-- Volume -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="🔊" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
            <Slider x:Name="VolumeSlider" Width="160" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="1" Value="0.5" IsMoveToPointEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged"/>
        </StackPanel>
    </Grid>
</Window>
