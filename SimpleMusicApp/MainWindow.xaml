<Window x:Class="SimpleMusicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Music Player" Height="640" Width="1000" MinHeight="520" MinWidth="820"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Library + Now playing -->
            <RowDefinition Height="88"/>    <!-- Player bar -->
        </Grid.RowDefinitions>

        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════ LEFT: Your Library ═════════ -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Margin="0,0,8,0" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                Content="&#xE710;" ToolTip="Add songs" Click="AddSongs_Click"/>
                        <TextBlock Text="Your Library" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid>
                        <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="20"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Text="Click + or drop music files here to build your playlist"/>

                        <ListBox x:Name="PlaylistBox" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlaylistItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="PlaylistBox_MouseDoubleClick"
                                 KeyDown="PlaylistBox_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <!-- Mini cover -->
                                        <Border Width="40" Height="40" CornerRadius="4" Margin="0,0,10,0"
                                                Background="{StaticResource ArtBrush}">
                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Local file" FontSize="12"
                                                       Foreground="{StaticResource SubTextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <!-- The playing song turns green -->
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="TitleText" Property="Foreground"
                                                    Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ═════════ RIGHT: Now playing + visualizer ═════════ -->
            <Border Grid.Column="1" CornerRadius="8" Padding="28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1F4D35" Offset="0"/>
                        <GradientStop Color="#121212" Offset="0.65"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <!-- Big cover: "beats" with the bass (ArtScale is changed from code) -->
                        <Border Width="190" Height="190" CornerRadius="8"
                                Background="{StaticResource ArtBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ArtScale"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="72"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,0">
                            <TextBlock Text="NOW PLAYING" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BigTitleText" Text="No song selected" FontSize="40"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                            <TextBlock x:Name="BigSubText" Text="Add some music to get started"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Visualizer: bars are created in code (see CreateVisualizerBars) -->
                    <UniformGrid x:Name="VisualizerGrid" Grid.Row="1" Rows="1" Margin="0,28,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════ BOTTOM: Player bar ═════════ -->
        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: current song -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="4" Background="{StaticResource ArtBrush}">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="180">
                    <TextBlock x:Name="SmallTitleText" Text="—" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Local file" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Center: controls + progress -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="600">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous" Click="Previous_Click"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                            Content="&#xE768;" ToolTip="Play / Pause (Space)" Click="PlayPause_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
                </StackPanel>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="11" TextAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="8,0"
                            Style="{StaticResource SpotifySlider}" Minimum="0" Maximum="1"
                            Thumb.DragStarted="ProgressSlider_DragStarted"
                            Thumb.DragCompleted="ProgressSlider_DragCompleted"
                            ValueChanged="ProgressSlider_ValueChanged"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" FontSize="11"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Right: volume -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="16"
                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Width="110" Margin="10,0,0,0"
                        Style="{StaticResource SpotifySlider}" Minimum="0" Maximum="1" Value="0.5"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
